# Copy to .env (never committed) for local runs. Free options only by default.
GROQ_API_KEY=            # free: console.groq.com
GEMINI_API_KEY=          # free tier: aistudio.google.com (do NOT link a billing account if you want €0)
SLACK_BOT_TOKEN=         # free Slack workspace
SLACK_CHANNEL=
SLACK_SIGNING_SECRET=
HUBSPOT_TOKEN=           # free HubSpot CRM private app
# Paid providers are refused unless you set this deliberately:
# KOMPASS_ALLOW_PAID=true
